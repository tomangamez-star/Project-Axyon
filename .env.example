DATABASE_URL=
WA_SESSION_ID=architect-primary
WA_MAX_SESSIONS=5
# Dashboard login is by WhatsApp number + a code the bot sends privately.
# No shared password is needed. Optional: how long a login lasts (hours).
DASHBOARD_SESSION_HOURS=720
PORT=3000
LOG_LEVEL=info
# Optional fallback if a WhatsApp zone invite code cannot be generated.
RYUDEN_COMMUNITY_URL=

# The in-bot assistant. Groq is the primary provider.
GROQ_API_KEY=
# Current Groq production model; can be overridden if desired.
GROQ_MODEL=openai/gpt-oss-120b

# AI provider fallback (optional). Groq is tried first. AI_API may be either
# an OpenAI-compatible chat-completions URL or an API key for api.openai.com.
# You can override the endpoint/model explicitly for another compatible host.
AI_API=
AI_API_URL=
AI_API_KEY=
AI_API_MODEL=gpt-4o-mini
