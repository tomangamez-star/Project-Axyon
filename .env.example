DATABASE_URL=
WA_SESSION_ID=architect-primary
WA_MAX_SESSIONS=5
# Dashboard login is by WhatsApp number + a code the bot sends privately.
# No shared password is needed. Optional: how long a login lasts (hours).
DASHBOARD_SESSION_HOURS=720
PORT=3000
LOG_LEVEL=info
# Optional fallback if a WhatsApp zone invite code cannot be generated.
RYUDEN_COMMUNITY_URL=

# The in-bot assistant. Public AI routes are tried first; this key is the
# fallback when they fail. Leave it blank to use public routes only.
# SerpApi Pinterest image search (set this in Render > Environment).
SERPAPI_API_KEY=
# Set true to fail card generation instead of using the existing artwork fallback.
SERPAPI_REQUIRED=true

GROQ_API_KEY=
# Optional model override for the Groq fallback.
GROQ_MODEL=llama-3.3-70b-versatile

# Optional external YouTube cookie jar path; never commit the cookie file.
YTDLP_COOKIES_FILE=
